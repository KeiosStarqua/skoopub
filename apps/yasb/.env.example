# Copy this file to ~/.config/yasb/.env and fill in the values you need.
# NEVER commit your real .env - it contains private keys and paths.

# Free API key from https://www.weatherapi.com/
YASB_WEATHER_API_KEY=
# e.g. "USA Los Angeles 90006" or just a city name
YASB_WEATHER_LOCATION=

# Folder of images for the wallpapers widget. Set automatically by
# apps/yasb/setup-wallpapers.ps1 to the cloned aesthetic-wallpapers/images dir.
YASB_WALLPAPER_DIR=
